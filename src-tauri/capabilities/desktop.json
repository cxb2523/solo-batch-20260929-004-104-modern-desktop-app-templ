{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "*"
  ],
  "permissions": [
    "updater:default",
    "store:default",
    "opener:default",
    "log:default",
    "core:window:allow-toggle-maximize",
    "fs:allow-download-write-recursive"
  ]
}
